<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration "lumen-installer": request 2 of a Windows release (docs/windows-signing.md).

  Paste this into SignPath (project > Artifact configurations > Add > XML) with the slug lumen-installer,
  or set the repository variable SIGNPATH_INSTALLER_CONFIG_SLUG to the slug you chose. SignPath does not
  read this file from the repository.

  The uploaded artifact is a zip holding only Lumen-Setup-<version>.exe, the NSIS installer electron-builder
  built from the directory whose Lumen.exe request 1 already signed. The installer is a self-extracting
  executable that SignPath cannot open, so it is signed as one file. The uninstaller inside it stays
  unsigned: electron-builder creates it during the build, before any request could sign it.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="productVersion" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="Lumen-Setup-*.exe" product-name="Lumen" product-version="${productVersion}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
