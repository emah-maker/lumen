<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration "lumen-app": request 1 of a Windows release (docs/windows-signing.md).

  Paste this into SignPath (project > Artifact configurations > Add > XML) with the slug lumen-app, or
  set the repository variable SIGNPATH_APP_CONFIG_SLUG to the slug you chose. SignPath does not read this
  file from the repository; it is kept here so the configuration is reviewed like any other change.

  The uploaded artifact is a zip holding only Lumen.exe (.github/workflows/release.yml, "Stage Lumen.exe
  for SignPath"). Only Lumen.exe is signed. The other binaries in the app (ffmpeg.dll, libEGL.dll, the
  Vulkan and DirectX libraries) are Chromium's and Electron's: signing them with the Foundation
  certificate would be signing upstream binaries (see "Eligibility" in docs/windows-signing.md).

  The metadata restriction makes SignPath refuse any Lumen.exe whose version info is not ProductName
  "Lumen" with the version the workflow read from the built file (electron-builder writes it, for 0.4.4
  as "0.4.4.0"), which is what SignPath Foundation requires of every signed binary.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="productVersion" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="Lumen.exe" product-name="Lumen" product-version="${productVersion}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
