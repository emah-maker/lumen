{
  "name": "lumen",
  "productName": "Lumen",
  "version": "0.2.4",
  "description": "Lumen: an AI browser that works with Claude, ChatGPT, Grok and Gemini, and with any AI agent through MCP",
  "main": "main.js",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "start": "electron .",
    "dist": "node scripts/build.js",
    "test": "node test/units.js && node test/smoke.js && node test/tools.js && node test/ui.js && node test/images.js && node test/models.js && node test/adhd.js && node test/extensions.js && node test/adblock.js && node test/pagecontext.js && node test/dialogs.js && node test/recovery.js && node test/tasklock.js && node test/tabstrip.js && node test/downloads.js && node test/hardening.js && node test/exfil.js",
    "install_app": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-windows.ps1",
    "dist:win": "node scripts/build.js --win",
    "dist:mac": "node scripts/build.js --mac"
  },
  "license": "GPL-3.0",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@ghostery/adblocker-electron": "^2.18.2",
    "electron-chrome-extensions": "^4.9.0",
    "electron-chrome-web-store": "^0.13.0",
    "openai": "^7.23.0",
    "tldts-experimental": "^7.4.15"
  },
  "devDependencies": {
    "electron": "github:castlabs/electron-releases#v44.1.0+wvcus",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.63.0"
  },
  "author": "Lumen",
  "build": {
    "appId": "com.lumen.browser",
    "productName": "Lumen",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "**/*",
      "!test/**",
      "!dist/**",
      "!*.md",
      "!build/**",
      "!.impeccable/**",
      "!**/.impeccable/**",
      "!scripts/**",
      "!.github/**",
      "!shot-*.png",
      "!docs/**"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "artifactName": "${productName}-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lumen",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Lumen ${version} Portable.exe"
    },
    "asar": false,
    "electronDownload": {
      "mirror": "https://github.com/castlabs/electron-releases/releases/download/"
    },
    "afterPack": "scripts/after-pack.js",
    "protocols": [
      {
        "name": "Web page",
        "schemes": [
          "http",
          "https"
        ],
        "role": "Viewer"
      }
    ],
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": "-"
    },
    "dmg": {
      "title": "Lumen",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    }
  }
}
