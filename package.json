{
  "name": "lumen",
  "productName": "Lumen",
  "version": "0.5.77",
  "description": "Lumen: an AI browser that works with Claude, ChatGPT, Grok and Gemini, and with any AI agent through MCP",
  "main": "src/main.js",
  "type": "commonjs",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "start": "electron .",
    "dist": "node scripts/build/build.js",
    "test": "node scripts/test/test-all.js",
    "test:units": "node scripts/test/test-units.js",
    "test:acceptance": "node scripts/test/test-acceptance.js",
    "land": "node scripts/release/land.js",
    "release": "node scripts/release/release.js",
    "lint": "eslint .",
    "measure": "node scripts/measure/measure-perf.js",
    "check:package": "node scripts/build/check-package.js",
    "install_app": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build/install-windows.ps1",
    "dist:win": "node scripts/build/build.js --win",
    "dist:mac": "node scripts/build/build.js --mac"
  },
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@ghostery/adblocker-electron": "^2.20.1",
    "electron-chrome-extensions": "^4.9.0",
    "electron-chrome-web-store": "^0.13.0",
    "electron-updater": "^6.8.10",
    "koffi": "^3.3.2",
    "openai": "^7.34.0",
    "postal-mime": "^4.0.7",
    "qrcode-generator": "^2.0.4",
    "tldts-experimental": "^7.4.18"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@eslint/js": "^10.0.1",
    "acorn": "8.19.0",
    "electron": "github:castlabs/electron-releases#v44.1.0+wvcus",
    "electron-builder": "^26.15.3",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "playwright-core": "^1.64.1"
  },
  "author": "Lumen",
  "build": {
    "appId": "com.lumen.browser",
    "productName": "Lumen",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "**/*",
      "!test/**",
      "!dist/**",
      "!*.md",
      "CHANGELOG.md",
      "!build/**",
      "!.impeccable/**",
      "!.claude/**",
      "!**/.impeccable/**",
      "!scripts/**",
      "!.github/**",
      "!shot-*.png",
      "!docs/**",
      "!site/**",
      "!_site/**",
      "!eslint.config.js",
      "!.editorconfig",
      "!**/node_modules/**/*.map",
      "!**/node_modules/**/*.{ts,mts,cts,tsbuildinfo}",
      "!**/node_modules/{openai,@anthropic-ai/sdk}/**/*.mjs",
      "!**/node_modules/{openai,@anthropic-ai/sdk}/src/**",
      "!**/node_modules/koffi/{doc,lib,vendor}/**",
      "!**/node_modules/koffi/src/koffi/src/**/*.{cc,hh,inc,def,S,asm}",
      "!**/node_modules/koffi/src/koffi/CMakeLists.txt",
      "!**/node_modules/koffi/cnoke.cjs",
      "!**/node_modules/@koromix/koffi-*/*/*.lib",
      "!**/node_modules/{@ghostery,@remusao}/*/dist/esm/**",
      "!**/node_modules/@ghostery/*/dist/*.umd.min.js",
      "!**/node_modules/{tldts-core,tldts-experimental}/dist/es6/**",
      "!**/node_modules/tldts-experimental/dist/index.{esm,umd}.min.js",
      "!**/node_modules/{electron-chrome-extensions,electron-chrome-web-store}/dist/esm/**"
    ],
    "electronLanguages": [
      "en-US",
      "en-GB",
      "de",
      "es",
      "es-419",
      "fr",
      "it",
      "pt-BR",
      "pt-PT",
      "nl",
      "pl",
      "ru",
      "tr",
      "ja",
      "ko",
      "zh-CN",
      "zh-TW"
    ],
    "win": {
      "icon": "src/assets/icon.png",
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "extraFiles": [
        "LICENSE",
        "THIRD_PARTY_NOTICES.md"
      ],
      "artifactName": "${productName}-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lumen",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Lumen ${version} Portable.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "emah-maker",
        "repo": "lumen",
        "releaseType": "release"
      }
    ],
    "asar": false,
    "electronDownload": {
      "mirror": "https://github.com/castlabs/electron-releases/releases/download/"
    },
    "afterPack": "scripts/release/after-pack.js",
    "afterSign": "scripts/release/after-sign.js",
    "protocols": [
      {
        "name": "Web page",
        "schemes": [
          "http",
          "https"
        ],
        "role": "Viewer"
      }
    ],
    "fileAssociations": [
      {
        "ext": [
          "html",
          "htm",
          "xhtml",
          "shtml"
        ],
        "name": "HTML Document",
        "role": "Viewer"
      },
      {
        "ext": [
          "pdf"
        ],
        "name": "PDF Document",
        "role": "Viewer"
      },
      {
        "ext": [
          "svg"
        ],
        "name": "SVG Image",
        "role": "Viewer"
      },
      {
        "ext": [
          "eml"
        ],
        "name": "Email Message",
        "role": "Viewer"
      }
    ],
    "mac": {
      "icon": "src/assets/icon.png",
      "category": "public.app-category.productivity",
      "extraResources": [
        "LICENSE",
        "THIRD_PARTY_NOTICES.md"
      ],
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "extendInfo": {
        "NSCameraUsageDescription": "Websites you allow can use your camera.",
        "NSMicrophoneUsageDescription": "Websites you allow can use your microphone, and so can Lumen's voice input in the chat box.",
        "NSLocationUsageDescription": "Websites you allow can know your location."
      }
    },
    "dmg": {
      "title": "Lumen",
      "iconSize": 96,
      "window": {
        "width": 540,
        "height": 360
      },
      "contents": [
        {
          "x": 140,
          "y": 170,
          "type": "file"
        },
        {
          "x": 400,
          "y": 170,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    }
  }
}
